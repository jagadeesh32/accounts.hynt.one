# accounts.hynt.one — configuration.
# Copy to backend/.env. The two that MUST be set in production are
# HYNT_DATABASE_URL and HYNT_COOKIE_DOMAIN.

# ── environment ──────────────────────────────────────────────────────────────
HYNT_ENV=production
HYNT_DEBUG=false
HYNT_HOST=127.0.0.1
HYNT_PORT=9000
HYNT_WORKERS=2

# Public origin. Must match exactly what the platforms are configured with —
# it becomes the `iss` claim, and a mismatch rejects every token.
HYNT_ISSUER=https://accounts.hynt.one

# ── database ─────────────────────────────────────────────────────────────────
HYNT_DATABASE_URL=postgresql+psycopg2://hynt_accounts:CHANGE_ME@localhost:5432/hynt_accounts
HYNT_DB_POOL_SIZE=10
HYNT_DB_MAX_OVERFLOW=20

# ── SSO cookie ───────────────────────────────────────────────────────────────
# The leading dot is what makes one login work across every *.hynt.one host.
# Without it the cookie is host-only and single sign-on does not happen at all.
HYNT_COOKIE_NAME=hynt_sso
HYNT_COOKIE_DOMAIN=.hynt.one
HYNT_COOKIE_SECURE=true
HYNT_COOKIE_SAMESITE=Lax

HYNT_SESSION_TTL_SEC=2592000        # 30 days, absolute
HYNT_SESSION_IDLE_TTL_SEC=1209600   # 14 days without use

# ── tokens ───────────────────────────────────────────────────────────────────
# Short by design: platforms verify locally, so this bounds how long a
# no-longer-valid token would be honoured if the revocation list were
# unreachable. With the revocation list working, revocation lands in ~30s.
HYNT_ACCESS_TOKEN_TTL_SEC=900
HYNT_AUTH_CODE_TTL_SEC=60
HYNT_REFRESH_TOKEN_TTL_SEC=2592000
HYNT_PASSWORD_RESET_TTL_SEC=1800

# RSA signing key. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing.pem
# Leave unset and one is generated into the database on first boot — fine for
# development, but then a deploy onto an empty database silently invalidates
# every live session, which is why production should pin it.
# HYNT_SIGNING_KEY_PATH=/etc/hynt/signing.pem

# ── CORS ─────────────────────────────────────────────────────────────────────
# The SPA origins that call /oauth/token. Cookies are never sent cross-origin,
# so this does not need (and cannot have) credentials.
HYNT_CORS_ORIGINS=https://terminal.hynt.one,https://xterminal.hynt.one,https://intelligence.hynt.one

# ── accounts SPA ─────────────────────────────────────────────────────────────
HYNT_ACCOUNT_APP_URL=https://accounts.hynt.one

# ── registration ─────────────────────────────────────────────────────────────
HYNT_ALLOW_SELF_REGISTRATION=false
HYNT_BOOTSTRAP_EMAIL=admin@hynt.one
# Leave blank and `manage bootstrap` generates one and prints it once.
HYNT_BOOTSTRAP_PASSWORD=

# ── login throttle ───────────────────────────────────────────────────────────
HYNT_LOGIN_MAX_ATTEMPTS=5
HYNT_LOGIN_WINDOW_SEC=900
HYNT_LOGIN_LOCKOUT_SEC=900
