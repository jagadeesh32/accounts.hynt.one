# accounts.hynt.one — production. Loaded by systemd (EnvironmentFile) and by
# pydantic-settings when the app is run by hand from this directory.
HYNT_ISSUER=https://accounts.hynt.one
HYNT_ENVIRONMENT=production
HYNT_DATABASE_URL=postgresql+asyncpg://hynt_accounts:CHANGE_ME@127.0.0.1:5432/hynt_accounts
HYNT_COOKIE_DOMAIN=.hynt.one
HYNT_COOKIE_SECURE=true
HYNT_TRUSTED_REDIRECT_HOSTS=hynt.one
