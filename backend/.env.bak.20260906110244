# accounts.hynt.one — production. Loaded by systemd (EnvironmentFile) and by
# pydantic-settings when the app is run by hand from this directory.
HYNT_ISSUER=https://accounts.hynt.one
HYNT_ENVIRONMENT=production
HYNT_DATABASE_URL=postgresql+asyncpg://hynt_accounts:ggUQcK4SRHjevBclWq8wce7cSc4KatHs@127.0.0.1:5432/hynt_accounts
HYNT_COOKIE_DOMAIN=.hynt.one
HYNT_COOKIE_SECURE=true
HYNT_TRUSTED_REDIRECT_HOSTS=hynt.one

# Cross-origin callers of this API.
#
# Required, not a dev convenience: @hynt/sso-web exchanges the auth code with
# fetch(issuer + "/oauth/token") from the platform's own page, and it sends
# content-type: application/json — which is not a CORS-simple request, so the
# browser preflights it. With this unset the preflight is answered 405 with no
# CORS headers and every platform sign-in dies as "Failed to fetch".
#
# Exact origins, never "*": allow_credentials is on, and the two are
# incompatible. Add localhost origins here only if you run a dev server against
# production accounts.
HYNT_CORS_ORIGINS=https://terminal.hynt.one,https://xterminal.hynt.one,https://intelligence.hynt.one
